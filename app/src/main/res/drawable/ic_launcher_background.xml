<?xml version="1.0" encoding="utf-8"?>
<!-- 图标底色（第 14 版）：由「深板岩蓝」换成「中性石墨灰」，并删掉板面细光斑。
     前几版的问题：底板本身是蓝的，中层圆盘也是蓝的，两者只差明度；再叠加窗反光、
     右下折射、盘后环境光三层淡光，缩到桌面 48dp 时就成了"一片带斑的蓝灰"——
     边界和圆盘都读不出来，观感发花。
     这一版只保留三样东西：
       ① 中性灰的对角渐变（无彩，与蓝盘彻底分开色相）；
       ② 整板一片很淡的左上受光（3% 白，只用来交待"面"的朝向）；
       ③ 四角暗角 + 一圈中性外沿（上左白、右下冷灰，不再掺蓝）。
     删掉的三层是"发花"的来源：窗反光与折射会在板面上留下椭圆/条状色块，
     盘后环境光则会在圆盘周围留一圈晕，三者在小尺寸下都读不出材质，只读成脏。
     外沿描边仍贴视口最外沿（内缩 2.6、宽 2.8、圆角 24），保证任意 launcher 遮罩
     都能裁出一条贴边亮线。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 底层：中性石墨灰对角渐变（无彩，不与中层蓝盘抢色相） -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF3C4249"
                android:centerColor="#FF2B3036"
                android:endColor="#FF1C2025" />
        </aapt:attr>
    </path>

    <!-- 板面受光：整块板被同一个左上光源照到，向右下渐隐。只给到 3% 白，
         作用是让"面"有朝向，不给材质信号 —— 再多就回到上一版的斑驳。 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="8"
                android:startY="6"
                android:endX="86"
                android:endY="94">
                <item android:offset="0" android:color="#00FFFFFF" />
                <item android:offset="0.32" android:color="#08FFFFFF" />
                <item android:offset="0.68" android:color="#00FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 暗角：四角沉下去，板的体积靠这一层，不再靠板面光斑。 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="82">
                <item android:offset="0" android:color="#00000000" />
                <item android:offset="0.48" android:color="#00000000" />
                <item android:offset="0.74" android:color="#1B000000" />
                <item android:offset="1" android:color="#47000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 外沿：一圈中性描边 —— 上左受光最亮，中段几乎为零，右下留一线冷灰。
         不掺蓝：板上唯一的蓝应该来自中层圆盘，边线上再出现蓝会削弱"灰板 + 蓝盘"
         的层次。 -->
    <path
        android:pathData="M2.6,26.6 A24,24 0 0 1 26.6,2.6 L81.4,2.6 A24,24 0 0 1 105.4,26.6 L105.4,81.4 A24,24 0 0 1 81.4,105.4 L26.6,105.4 A24,24 0 0 1 2.6,81.4 Z"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="16"
                android:startY="16"
                android:endX="92"
                android:endY="92">
                <item android:offset="0" android:color="#64FFFFFF" />
                <item android:offset="0.3" android:color="#20FFFFFF" />
                <item android:offset="0.58" android:color="#09FFFFFF" />
                <item android:offset="0.8" android:color="#0F8A93A0" />
                <item android:offset="1" android:color="#268A93A0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
