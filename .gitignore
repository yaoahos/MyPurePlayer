# ---------------------------------------------------------------------------
# MyPurePlayer - Git 忽略规则
# 只提交源码、构建脚本与文档，排除构建产物、本机配置、签名材料与调试残留。
# 规则与仓库的目录结构保持一致，不保留其它项目遗留的条目。
# ---------------------------------------------------------------------------

# ---- 签名与密钥（绝不提交）----
# 统一放在 signing/ 下管理，整个目录不纳入版本控制
/signing/

# ---- 本机配置 ----
local.properties

# ---- Gradle / Kotlin 构建产物 ----
.gradle/
.kotlin/
build/
**/build/

# ---- 发布产物（APK 只通过 Releases 分发）----
dist/
*.apk
*.aab
*.ap_
output-metadata.json
mapping.txt

# ---- Android 调试与内存快照 ----
*.hprof

# ---- 非运行必需的本地资产与工具（源图/发布脚本不纳入版本控制）----
/assets/
/tools/

# ---- 临时抓图目录（README 界面预览用的 docs/screenshots 需纳入版本控制，不忽略）----
.tmp/

# ---- 本机写作参考与协作备忘（不纳入版本控制）----
changelog-spec.md
motion-prompt.md

# ---- 工具本地状态：含本机路径日志、截图等 ----
.workbuddy/

# ---- 日志与临时文件 ----
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*~
